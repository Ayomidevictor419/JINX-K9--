# Required hosting-panel secrets (keep actual values in config.env)
BOT_TOKEN=
STARTUP_PASSWORD=

# 𝙅𝙄𝙉𝙓 𝙆9 portable AI configuration
# NEVER share these values or commit them to a public repository.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Optional Pollinations
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=openai

# Group chatbot
CHATBOT_PROVIDER=auto
CHATBOT_MODE=mention
CHATBOT_COOLDOWN_MS=8000
CHATBOT_MAX_PER_HOUR=30
CHATBOT_MEMORY_TURNS=8

# 𝙅𝙄𝙉𝙓 𝙆9 V1 media features
POLLINATIONS_IMAGE_MODEL=flux
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
